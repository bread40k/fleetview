 "routes": {
  "group1": [["07 00:00", 53.9, 7.9, "Ten destroyers with 2,000 mountain troops embarked, sailed from the Weser overnight with Group 2 and the battleships", "R"], ["07 13:25", 56.8, 5.5, "Twelve Blenheims attack — no hits", "R"], ["08 08:00", 64.2, 6.5, "Bernd von Arnim and Hans Lüdemann brush with Glowworm in the gale", "R"], ["08 12:00", 65.5, 7.5, "The groups part; Group 1 heads for Vestfjord", "R"], ["08 22:00", 67.6, 12.5, "Vestfjord entrance", "R"], ["09 02:00", 68.19, 15.61, "Tranøy; Norwegian patrol boats captured", "R"], ["09 03:00", 68.36, 16.2, "Enters Ofotfjord at Barøy in driving snow; Roeder left as picket, Lüdemann and Schmitt land troops at Ramnes", "R"], ["09 04:15", 68.43, 17.37, "Off Narvik; Eidsvold challenges — a parley, then Heidkamp's torpedoes", "S"]],
  "lutjens": [["07 00:00", 53.9, 7.9, "Scharnhorst and Gneisenau cover the northern groups", "R"], ["08 12:00", 65.5, 7.5], ["09 03:37", 67.4, 9.8, "Renown sighted in the murk", "R"], ["09 04:05", 67.367, 9.7, "Action off Lofoten: Gneisenau's fire control knocked out", "S"], ["09 06:15", 67.8, 8.8, "Breaks off north-west at 28 knots into the storm", "R"], ["10 12:00", 70.5, 3, "Far out in the Norwegian Sea", "R"], ["12 20:00", 53.55, 8.1, "Back at Wilhelmshaven", "R"], ["14 12:00", 53.55, 8.1]],
  "hipper": [["07 00:00", 53.9, 7.9, "Hipper and four destroyers for Trondheim", "R"], ["08 09:58", 64.217, 6.467, "Sights Glowworm; opens fire at 8,400 m", "S"], ["08 10:24", 64.22, 6.5, "Rammed abaft the starboard anchor — 500 tons of flooding", "S"], ["08 12:00", 64.5, 7.5], ["09 03:00", 63.65, 9.45, "Trondheimsfjord entrance", "R"], ["09 05:00", 63.43, 10.4, "Bluffs past the forts into Trondheim with British recognition signals", "R"], ["10 12:00", 63.43, 10.4, "Sails for Germany", "R"], ["10 15:00", 63.65, 9.45], ["12 12:00", 53.52, 8.13, "Wilhelmshaven", "R"], ["14 12:00", 53.52, 8.13]],
  "glowworm": [["07 00:00", 60.9, 0.5, "Escorting Renown", "R"], ["07 12:00", 61.5, 1.5, "Detached to search for a man overboard", "R"], ["08 07:15", 64.1, 6.3, "Meets Hans Lüdemann, then Bernd von Arnim", "R"], ["08 10:24", 64.217, 6.467, "Rams Hipper and blows up — 109 lost. Roope's VC is recommended by Hipper's captain", "S"]],
  "2df": [["07 04:00", 60.46, -1.28, "Hardy, Hunter, Havock, Hotspur sail from Sullom Voe with the minelayers", "S"], ["08 05:00", 67.6, 14, "Minefield laid in Vestfjord off Hovden, 04:32–05:29", "R"], ["09 04:05", 67.5, 10, "Falls behind Renown in the gale; ordered to guard the Vestfjord entrance", "R"], ["09 16:00", 68.19, 15.61, "Hostile joins; the Tranøy pilots report 'six destroyers and a submarine' at Narvik", "S"], ["09 21:00", 67.95, 15, "Steams west to time a dawn arrival — U-51 takes it for a withdrawal", "R"], ["10 04:15", 68.42, 17.25, "Off Narvik after fifty miles of blinding snow; visibility two cables", "R"], ["10 04:30", 68.43, 17.37, "Hardy fires seven torpedoes into the harbour: Heidkamp's stern blown off, Bonte killed", "S"], ["10 05:40", 68.42, 17.2, "Third pass complete; withdrawing at 30 knots — three destroyers sighted from Herjangsfjord", "R"], ["10 05:58", 68.4, 17.05, "Thiele and Arnim cross ahead from Ballangen at 4,000 m", "R"], ["10 07:00", 68.39, 16.7, "Hotspur conned from aft, Hostile covering", "R"], ["10 08:00", 68.408, 16.467, "The ammunition ship Rauenfels stopped and blown up by Havock", "S"], ["10 16:40", 68.05, 13.27, "Skjelfjord anchorage; Penelope's repair base", "S"], ["14 12:00", 68.05, 13.27]],
  "whitworth": [["07 04:00", 60.5, -1.2, "Renown covering the minelayers", "R"], ["08 17:15", 67.41, 11.87, "Rendezvous off Skomvær light", "S"], ["09 04:05", 67.367, 9.7, "Opens fire at 04:05 in a snowstorm; three hits on Gneisenau, two unexploded 11-inch on Renown", "S"], ["09 06:15", 67.6, 9, "Action broken off", "R"], ["10 12:00", 67.9, 13.5, "Patrols the Vestfjord approaches", "R"], ["13 07:30", 67.733, 13.367, "Whitworth shifts his flag to Warspite", "S"], ["14 12:00", 67.7, 13]],
  "forceb": [["12 07:30", 66.45, 6, "Warspite detached from the Home Fleet with nine destroyers", "S"], ["13 07:30", 67.733, 13.367, "Rendezvous 67°44′N 13°22′E; Whitworth embarks", "S"], ["13 10:45", 68.19, 15.61, "Eskimo joins; a U-boat sighted and driven down", "R"], ["13 11:52", 68.33, 16.05, "Swordfish catapulted five miles west of Barøy", "R"], ["13 12:59", 68.4, 16.75, "Opens fire on Koellner at Djupvik", "R"], ["13 14:00", 68.42, 17.15, "Running fight in the wide fjord; Roeder's shells hit Cossack", "R"], ["13 15:00", 68.44, 17.5, "Into Rombaksfjord behind the destroyers", "R"], ["13 15:30", 68.45, 17.62], ["13 18:32", 68.42, 17, "Withdraws down the fjord — 'All German destroyers sunk'", "R"], ["14 02:50", 68.43, 17.35, "Returns to Narvik overnight to embark the wounded", "R"], ["14 12:00", 68.3, 16.2]],
  "eidsvold": [["07 00:00", 68.43, 17.37, "Coast-defence ship Eidsvold guards Narvik", "S"]],
  "norge": [["07 00:00", 68.43, 17.39, "Coast-defence ship Norge in the harbour", "S"]],
  "u64": [["11 12:00", 68.3, 16.1, "Arrives in Vestfjord for Operation Hartmut", "R"], ["13 09:00", 68.5, 17.48, "Into Herjangsfjord", "R"], ["13 12:05", 68.483, 17.5, "Bombed by Warspite's Swordfish while hove-to off Bjerkvik — the first U-boat sunk by an aircraft", "S"]],
  "u51": [["08 12:00", 67.8, 13.5, "Patrolling the Vestfjord approaches", "R"], ["09 20:22", 68.1, 15, "Sights the 2nd Flotilla steering west — reports a withdrawal", "R"], ["10 09:00", 68.2, 15.8, "Attacks the retiring flotilla; every torpedo fails", "R"], ["14 12:00", 67.9, 14]],
  "janwellem": [["07 00:00", 71.2, 26, "Whaling tanker from 'Basis Nord' near Murmansk", "R"], ["08 12:00", 68.428, 17.385, "Narvik: the only tanker to arrive; seven hours to fuel two destroyers", "S"]],
  "rauenfels": [["07 00:00", 61, 4, "Ammunition and artillery ship, late", "R"], ["10 08:00", 68.408, 16.467, "Stopped by Hostile, boarded and blown up by Havock at the fjord entrance", "S"]]
