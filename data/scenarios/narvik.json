 "commanders": {
  "group1": { "name": "Kommodore Friedrich Bonte", "role": "Führer der Zerstörer — Group 1", "flagship": "Wilhelm Heidkamp", "bio": "Brought ten destroyers and 2,000 mountain troops 1,200 miles through a gale to take Narvik in a morning. Kept his flagship in the harbour that night at Dietl's request, trusting a picket that went home at dawn.", "fate": "Killed in Heidkamp by Hardy's torpedo, 10 April 1940; Erich Bey took over.", "wiki": "Friedrich_Bonte" },
  "lutjens": { "name": "Vizeadmiral Günther Lütjens", "role": "Commander, Covering Force", "flagship": "Gneisenau", "bio": "Drew Renown off into the storm on 9 April with the two battleships — and thereby uncovered Vestfjord. A year later he would take Bismarck into the Atlantic.", "fate": "Lost with Bismarck, 27 May 1941.", "wiki": "Günther_Lütjens" },
  "hipper": { "name": "Kapitän zur See Hellmuth Heye", "role": "Commanding Officer, Admiral Hipper — Group 2", "flagship": "Admiral Hipper", "bio": "Sank Glowworm after she rammed him, then wrote through the Red Cross recommending her captain for the Victoria Cross. Took Trondheim the next morning by bluff.", "fate": "Survived the war; later a Bundestag member and Wehrbeauftragter.", "wiki": "Hellmuth_Heye" },
  "glowworm": { "name": "Lieutenant-Commander Gerard Roope", "role": "Commanding Officer, HMS Glowworm", "flagship": "HMS Glowworm", "bio": "Detached to look for a man overboard, met two German destroyers and then the Hipper; fired his torpedoes, laid smoke and rammed. 109 of his crew died with him.", "fate": "Victoria Cross, gazetted July 1945 — on the enemy's recommendation.", "wiki": "Gerard_Broadmead_Roope" },
  "2df": { "name": "Captain Bernard Warburton-Lee", "role": "Captain (D), 2nd Destroyer Flotilla", "flagship": "HMS Hardy", "bio": "Told there were six destroyers and a submarine in Narvik, he signalled 'intend attacking at dawn' and went in with five ships through fifty miles of snow. Sank two destroyers and six merchantmen for the loss of Hardy and Hunter — and his own life.", "fate": "Mortally wounded on Hardy's bridge; the first Victoria Cross of the war.", "wiki": "Bernard_Warburton-Lee" },
  "forceb": { "name": "Vice-Admiral William Whitworth", "role": "Vice-Admiral, Battle Cruiser Squadron", "flagship": "HMS Renown, then HMS Warspite", "bio": "Fought Scharnhorst and Gneisenau off Lofoten in Renown, then took Warspite up Ofotfjord on 13 April behind nine destroyers and her own Swordfish and destroyed every German ship left. Recommended an immediate landing — which came six weeks late.", "fate": "Second Sea Lord 1941–44; died 1973.", "wiki": "William_Whitworth_(Royal_Navy_officer)" },
  "eidsvold": { "name": "Kaptein Odd Isaachsen Willoch", "role": "Commanding Officer, HNoMS Eidsvold", "flagship": "HNoMS Eidsvold", "bio": "Challenged the German flagship, received her emissary, and refused to surrender. Heidkamp's torpedoes were fired while the parley boat was still pulling away.", "fate": "Killed with 174 of his crew, 9 April 1940." },
  "norge": { "name": "Kaptein Per Askim", "role": "Commanding Officer, HNoMS Norge — senior officer, Ofotfjord", "flagship": "HNoMS Norge", "bio": "Opened fire on Bernd von Arnim alongside the pier at 800 metres; in the snow and dark every salvo went over, and seven torpedoes answered.", "fate": "Survived; interned by Sweden, later in London with the Free Norwegian forces." },
  "u64": { "name": "Kapitänleutnant Georg-Wilhelm Schulz", "role": "Commanding Officer, U-64", "flagship": "U-64", "bio": "Arrived in Vestfjord on 11 April and was caught on the surface off Bjerkvik by Warspite's Swordfish two days later — the first submarine ever sunk by an aircraft.", "fate": "Survived; later commanded U-124; died 1986." }
 },
 "ships": [
