 "routes": {
  "iachino": [["26 21:30", 40.84, 14.25, "Vittorio Veneto sails from Naples with four destroyers", "S"], ["27 06:00", 38.25, 15.6, "The 3rd Division joins off Messina", "R"], ["27 12:20", 36.9, 17.167, "A 230 Squadron Sunderland reports 'three cruisers and a destroyer' — the cover story for Ultra", "S"], ["27 22:00", 35.6, 20, "Supermarina cancels the Aegean sweep; the whole force to concentrate south of Crete", "R"], ["28 06:35", 34.9, 23.2, "Vittorio Veneto's Ro.43 sights Pridham-Wippell's cruisers", "R"], ["28 10:58", 34.45, 23.9, "Opens fire on Orion's squadron at 16 miles — 94 rounds of 15-inch in 29 salvoes", "R"], ["28 11:27", 34.5, 23.7, "Formidable's first Albacore strike; Iachino turns for home at 28 knots", "R"], ["28 15:19", 35.3, 21.9, "Lt Cdr Dalyell-Stead's torpedo hits the port quarter; 4,000 tons of water, stopped for six minutes", "R"], ["28 19:50", 35.3, 21.1, "Dusk strike: five columns, smoke and searchlights — Pola hit and stopped", "R"], ["29 08:00", 36.7, 18.5], ["29 17:00", 39, 18.4], ["30 00:00", 40.47, 17.24, "Taranto", "R"], ["1941-04-01 18:00", 40.47, 17.24]],
  "sansonetti": [["27 06:00", 38.25, 15.6, "Trieste, Trento, Bolzano and three destroyers", "S"], ["27 12:20", 36.949999999999996, 17.167, "Sighted by the Sunderland", "S"], ["28 06:00", 34.6, 24.2], ["28 08:12", 34.4, 24.3, "Opens fire on Orion's squadron at 25,000 yards", "R"], ["28 08:55", 34.15, 24.7, "Ceases fire and turns north-west — Pridham-Wippell follows", "R"], ["28 10:58", 34.45, 24, "Has drawn the British cruisers under Vittorio Veneto's guns", "R"], ["28 12:00", 34.75, 23.5], ["28 15:15", 35.3, 21.95], ["28 19:50", 35.3, 21.15], ["29 08:00", 36.7, 18.5], ["30 00:00", 38.25, 15.6], ["1941-04-01 18:00", 38.25, 15.6]],
  "cattaneo": [["26 11:00", 40.47, 17.24, "Zara, Fiume, Pola and four destroyers sail from Taranto", "S"], ["27 10:00", 37.3, 17.8, "Joins the fleet", "R"], ["27 22:00", 35.7, 20.1], ["28 12:00", 35, 23, "Ten miles north of Vittorio Veneto", "R"], ["28 15:15", 35.4, 21.95], ["28 19:50", 35.25, 21, "Pola torpedoed in the dusk attack; stopped, without power", "S"], ["28 21:06", 35.5, 20.75, "Zara, Fiume, Alfieri, Carducci, Gioberti and Oriani reverse course to stand by Pola — destroyers astern", "R"], ["28 22:27", 35.35, 20.95, "Greyhound's searchlight: Warspite, Valiant and Barham open fire at 3,800 yards", "S"], ["29 00:00", 35.6, 20.7, "Oriani and Gioberti escape north-west", "R"], ["29 12:00", 37.3, 18.5], ["30 00:00", 40.47, 17.24], ["1941-04-01 18:00", 40.47, 17.24]],
