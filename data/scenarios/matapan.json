 "commanders": {
  "iachino": { "name": "Ammiraglio di squadra Angelo Iachino", "role": "Commander-in-Chief, Italian Fleet", "flagship": "Vittorio Veneto", "bio": "Sent to sweep the convoy routes on German assurances that the British had one battleship fit for sea and no carrier. Believed Cunningham was 170 miles astern when he sent Cattaneo back for Pola — into a battlefleet that was 50.", "fate": "Kept his command until April 1943; wrote two books explaining Matapan; died 1976.", "wiki": "Angelo_Iachino" },
  "cattaneo": { "name": "Ammiraglio di divisione Carlo Cattaneo", "role": "Commander, 1st Division", "flagship": "Zara", "bio": "Ordered back at 21:06 to tow Pola home, with his destroyers astern instead of ahead and his guns unmanned for the night. Warspite's searchlights found him at 3,800 yards.", "fate": "Lost with Zara, 29 March 1941; Medaglia d'oro.", "wiki": "Carlo_Cattaneo_(admiral)" },
  "sansonetti": { "name": "Ammiraglio di divisione Luigi Sansonetti", "role": "Commander, 3rd Division", "flagship": "Trieste", "bio": "Fought the only gun action of the day, an hour at extreme range with Pridham-Wippell's cruisers, and drew them toward Vittorio Veneto exactly as intended.", "fate": "Deputy Chief of Naval Staff 1941–43; died 1959.", "wiki": "Luigi_Sansonetti" },
  "legnani": { "name": "Ammiraglio di divisione Antonio Legnani", "role": "Commander, 8th Division", "flagship": "Duca degli Abruzzi", "bio": "Two light cruisers that never saw the enemy.", "fate": "Died 1943.", "wiki": "Antonio_Legnani" },
  "forcea": { "name": "Admiral Sir Andrew Cunningham", "role": "Commander-in-Chief, Mediterranean Fleet", "flagship": "HMS Warspite", "bio": "Given the enemy's sailing orders by Bletchley Park, he covered the source with a Sunderland and a round of golf, took his three old battleships to sea after dark, and — against his staff's advice — pressed on into the night after the crippled Vittorio Veneto. Three heavy cruisers and two destroyers for one Albacore.", "fate": "First Sea Lord 1943–46; Viscount Cunningham of Hyndhope.", "wiki": "Andrew_Cunningham,_1st_Viscount_Cunningham_of_Hyndhope" },
  "forceb": { "name": "Vice-Admiral Henry Pridham-Wippell", "role": "Vice-Admiral, Light Forces", "flagship": "HMS Orion", "bio": "Led four cruisers on a running fight with Sansonetti's 8-inch ships, then found himself under Vittorio Veneto's 15-inch guns at 16 miles. Twenty minutes of straddles, no hits; the Albacores got him out.", "fate": "Commander-in-Chief Dover 1942–45; died 1952.", "wiki": "Henry_Pridham-Wippell" }
 },
