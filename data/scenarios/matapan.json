  "gradisca": [["30 12:00", 40.47, 17.24, "Hospital ship Gradisca sails on Cunningham's plain-language signal to Rome", "R"], ["31 21:00", 35.683, 21.183, "Arrives at the survivors' position; picks up 160 from Alfieri's rafts through 1 April", "S"], ["1941-04-01 18:00", 36.2, 20.5]],
  "forcea": [["27 19:00", 31.2, 29.92, "Warspite, Barham, Valiant, Formidable and nine destroyers sail after dark — Cunningham has spent the afternoon at the golf club", "S"], ["28 08:27", 33.9, 25.8, "Pridham-Wippell bears 267°, 90 miles; Valiant sent ahead", "R"], ["28 12:30", 34.1, 24.8, "Force B rejoins", "R"], ["28 15:15", 34.4, 23.7, "Vittorio Veneto bears 290°, 65 miles, making 15 knots", "R"], ["28 19:00", 34.9, 22.2], ["28 20:40", 35.05, 21.7, "Mack's eight destroyers sent ahead to attack the crippled battleship", "R"], ["28 22:10", 35.3, 21.05, "Valiant's radar: a stopped ship six miles on the port bow", "R"], ["28 22:27", 35.32, 21, "Two Zara-class cruisers cross the bows at 3,800 yards, turrets trained fore and aft", "S"], ["28 23:30", 35.45, 21.05, "The battlefleet withdraws north-east; four destroyers left to finish the cruisers", "R"], ["29 07:00", 35.9, 21.633, "Rendezvous 35°54′N 21°38′E", "S"], ["29 08:00", 35.717, 21.667, "Sweeps 220° over the battle area", "S"], ["29 11:00", 35.5, 21.2, "Survivors picked up until German aircraft appear; course 120° for Alexandria", "R"], ["30 17:30", 31.2, 29.92, "Alexandria", "S"], ["1941-04-01 18:00", 31.2, 29.92]],
