 "commanders": {
  "tf17": { "name": "Rear Admiral Frank Jack Fletcher", "role": "Commander, Task Force 17", "flagship": "USS Yorktown", "bio": "Fought the first carrier battle in history on the strength of Nimitz's codebreakers, spent his whole strike on a light carrier on 7 May, and traded blows evenly on the 8th. Lost Lexington — but Port Moresby was never invaded.", "fate": "Commanded again at Midway a month later; died 1973.", "wiki": "Frank_Jack_Fletcher" },
  "tf11": { "name": "Rear Admiral Aubrey Fitch", "role": "Commander, Task Force 11 — tactical command of the air on 8 May", "flagship": "USS Lexington", "bio": "The aviator among Fletcher's admirals; given the air battle at 09:08 on the 8th. Watched Lexington burn under him all afternoon after a leaking gasoline system did what the Japanese could not.", "fate": "Commander Aircraft South Pacific; Superintendent of the Naval Academy; died 1978.", "wiki": "Aubrey_Fitch" },
  "tg173": { "name": "Rear Admiral John Crace", "role": "Commander, Task Group 17.3 (Support Group)", "flagship": "HMAS Australia", "bio": "Sent without air cover to block Jomard Passage, was attacked by 31 land-based bombers and three friendly B-17s in half an hour and lost nothing — then held his station for another two days.", "fate": "Admiral; Superintendent of Chatham Dockyard; died 1968.", "wiki": "John_Gregory_Crace" },
  "mo": { "name": "Vice Admiral Takeo Takagi", "role": "Commander, MO Carrier Striking Force (air command: Rear Admiral Chūichi Hara)", "flagship": "Myōkō · Zuikaku", "bio": "Came round the Solomons unseen, passed within 70 miles of Fletcher in the dark, sank an oiler with 78 aircraft and lost 21 more at dusk. On the 8th Hara's aviators sank Lexington — and Shōkaku and Zuikaku's air groups were so depleted that neither carrier sailed for Midway.", "fate": "Takagi killed on Saipan, July 1944; Hara survived the war.", "wiki": "Takeo_Takagi" },
  "goto": { "name": "Rear Admiral Aritomo Gotō", "role": "Commander, MO Main Force", "flagship": "Aoba", "bio": "Covering the convoy with Shōhō and four heavy cruisers when 93 American aircraft arrived; the light carrier lasted 23 minutes.", "fate": "Mortally wounded at Cape Esperance, October 1942.", "wiki": "Aritomo_Got%C5%8D" },
  "invasion": { "name": "Rear Admiral Sadamichi Kajioka", "role": "Commander, Port Moresby Attack Force", "flagship": "Yūbari", "bio": "The conqueror of Wake, escorting eleven transports to Port Moresby at eight knots; turned back on 7 May and never got there.", "fate": "Killed when Shikinami was torpedoed, September 1944.", "wiki": "Sadamichi_Kajioka" },
  "tulagi": { "name": "Rear Admiral Kiyohide Shima", "role": "Commander, Tulagi Invasion Force", "flagship": "Okinoshima", "bio": "Took Tulagi without a shot on 3 May and lost a destroyer and three minesweepers to Yorktown the next morning; his flagship was torpedoed on the way home.", "fate": "Led the 2nd Striking Force at Surigao Strait; died 1973.", "wiki": "Kiyohide_Shima" }
 },
