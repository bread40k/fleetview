 "commanders": {
  "force1": { "name": "Vice-Admiral Sir Henry Moore", "role": "Second-in-Command, Home Fleet — commanding the strike", "flagship": "HMS Anson", "bio": "Planned Tungsten and led it from Anson when Fraser turned back. Forty Barracudas in two waves put fifteen bombs into Tirpitz for four aircraft; he declined to go back the next morning with tired crews against defences now awake — a decision the Admiralty regretted.", "fate": "Commander-in-Chief Home Fleet 1944–45; died 1978.", "wiki": "Henry_Ruthven_Moore" },
  "dukeofyork": { "name": "Admiral Sir Bruce Fraser", "role": "Commander-in-Chief, Home Fleet", "flagship": "HMS Duke of York", "bio": "Sailed with the convoy cover, brought the attack forward a day on the weather and the Enigma decrypts, then took his flagship west as a guard against Tirpitz sortieing — and left the strike to Moore.", "fate": "First Sea Lord 1948–51.", "wiki": "Bruce_Fraser,_1st_Baron_Fraser_of_North_Cape" },
  "force2": { "name": "Rear-Admiral Arthur Bisset", "role": "Rear-Admiral Escort Carriers — Force 2", "flagship": "HMS Royalist", "bio": "Five carriers including four escort carriers on their first fleet operation, carrying the fighter wings that swept Kåfjord's flak.", "fate": "Retired 1945; died 1956.", "wiki": "Arthur_La_Touche_Bisset" },
  "jw58": { "name": "Rear-Admiral Frederick Dalrymple-Hamilton", "role": "Commander, ocean escort JW 58", "flagship": "HMS Diadem", "bio": "Forty-seven ships against seventeen U-boats and the Luftwaffe: three U-boats and six aircraft destroyed, not a merchantman touched — while the convoy also served as the cover story for Tungsten.", "fate": "Admiral; died 1974.", "wiki": "Frederick_Dalrymple-Hamilton" },
  "tirpitz": { "name": "Kapitän zur See Hans Meyer", "role": "Commanding Officer, Tirpitz", "flagship": "Tirpitz", "bio": "Had his ship ready for sea after six months' repair when the Barracudas came over the hill at 05:29, with the anchor coming in and the watertight doors open. Wounded in the first minute; 122 of his crew killed.", "fate": "Relieved 1 May 1944; Bundesmarine flotilla admiral; died 1989.", "wiki": "Hans_Karl_Meyer" }
 },
