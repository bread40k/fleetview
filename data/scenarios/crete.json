  "c": [["20 22:00", 35.35, 26.55, "Through the Kaso Strait; a skirmish with Italian MAS boats", "R"], ["21 05:00", 35.5, 25.8], ["21 12:49", 34.583, 26.567, "Juno hit by three bombs, sinks in two minutes", "S"], ["21 20:00", 35, 26.3], ["22 04:00", 35.5, 25.2, "Off Heraklion; sweeps north-west", "R"], ["22 08:30", 36, 24.7, "Perth sinks a lone caique", "R"], ["22 10:00", 36.25, 24.6, "25 miles south of Milos: the Sagittario convoy — 38 caiques, 4,000 troops for Heraklion", "S"], ["22 10:10", 36.2, 24.5, "King turns away: Carlisle down to 21 knots, Naiad's ammunition low", "R"], ["22 13:21", 36, 23.4, "Naiad two turrets out; Carlisle hit, Captain Hampton killed", "R"], ["22 14:00", 35.95, 23.1, "Meets Force A1", "R"], ["22 20:00", 35.3, 23], ["24 08:00", 31.2, 29.88, null, "S"], ["1941-06-02 00:00", 31.2, 29.88]],
