 "commanders": {
  "a1": { "name": "Rear-Admiral Bernard Rawlings", "role": "Rear-Admiral, 7th Cruiser Squadron — Force A1; Heraklion force", "flagship": "HMS Warspite, then HMS Orion", "bio": "Held the battleships west of Crete for three days under air attack, then took the cruisers to Heraklion and brought 4,000 soldiers out through the Kaso Strait at dawn — losing a fifth of them and 260 of Orion's own people on the way.", "fate": "Commanded the British Pacific Fleet's carriers in 1945; died 1962.", "wiki": "Bernard_Rawlings" },
  "c": { "name": "Rear-Admiral Edward King", "role": "Rear-Admiral, 15th Cruiser Squadron — Force C", "flagship": "HMS Naiad, then HMS Phoebe", "bio": "Found the second invasion convoy south of Milos on 22 May and turned away for want of ammunition — a decision Cunningham never forgave, though the convoy did turn back. Led the biggest Sphakia lift a week later.", "fate": "Assistant Chief of Naval Staff 1942; died 1971.", "wiki": "Edward_Leigh_Stuart_King" },
  "d": { "name": "Rear-Admiral Irvine Glennie", "role": "Rear-Admiral (Destroyers) — Force D", "flagship": "HMS Dido", "bio": "Ran into the Maleme-bound caique convoy at 23:30 on 21 May and spent two and a half hours destroying it — the only seaborne landing the Germans attempted was stopped dead.", "fate": "Commander-in-Chief America and West Indies 1945; died 1980.", "wiki": "Irvine_Glennie" },
  "b": { "name": "Captain Henry Rowley", "role": "Commanding Officer, HMS Gloucester — senior officer Force B", "flagship": "HMS Gloucester", "bio": "Sent back into the Kithera Channel with 18% of his AA ammunition to cover Greyhound's rescue. Gloucester was stopped and burning within the hour; 722 of her crew died.", "fate": "Killed 22 May 1941; his body came ashore at Mersa Matruh four weeks later." },
  "5df": { "name": "Captain Lord Louis Mountbatten", "role": "Captain (D), 5th Destroyer Flotilla", "flagship": "HMS Kelly", "bio": "Brought five destroyers from Malta, bombarded Maleme by night and was caught by twenty-four Stukas at dawn. Kelly capsized under him at 30 knots.", "fate": "Survived; Supreme Allied Commander South-East Asia, last Viceroy of India; murdered 1979.", "wiki": "Louis_Mountbatten,_1st_Earl_Mountbatten_of_Burma" },
  "formidable": { "name": "Vice-Admiral Henry Pridham-Wippell", "role": "Vice-Admiral, 1st Battle Squadron — Force A", "flagship": "HMS Queen Elizabeth", "bio": "Took Formidable — with twelve serviceable fighters — to strike Scarpanto on 26 May; the Stukas found her on the way home.", "fate": "Commander-in-Chief Dover 1942–45; died 1952.", "wiki": "Henry_Pridham-Wippell" },
  "sphakia2": { "name": "Rear-Admiral Edward King", "role": "Force D — the second Sphakia lift", "flagship": "HMS Phoebe", "bio": "6,000 men in one night from an open beach, with Glengyle's landing craft.", "fate": "", "wiki": "Edward_Leigh_Stuart_King" },
  "lupo": { "name": "Tenente di Vascello Francesco Mimbelli", "role": "Commanding Officer, Lupo", "flagship": "Lupo", "bio": "Escorting twenty-five caiques with a single torpedo boat, he turned into three cruisers and four destroyers, fired his torpedoes at point-blank range and got Lupo home with eighteen hits. His convoy was destroyed but he was decorated by both Italy and Germany.", "fate": "Survived; a postwar admiral.", "wiki": "Francesco_Mimbelli" },
  "sagittario": { "name": "Tenente di Vascello Giuseppe Cigala Fulgosi", "role": "Commanding Officer, Sagittario", "flagship": "Sagittario", "bio": "Laid smoke and attacked Force C with torpedoes while his thirty-eight caiques turned back — and saw King break off. The Heraklion landing never happened, but not one of his soldiers drowned.", "fate": "Medaglia d'oro; survived the war." }
 },
