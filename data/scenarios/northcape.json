 "groups": { "scharnhorst": "Scharnhorst", "zflot": "4th Flotilla", "force1": "Force 1", "force2": "Force 2", "convoy": "JW 55B" },
 "commanders": {
  "scharnhorst": { "name": "Konteradmiral Erich Bey", "role": "Commander, Battle Group (in place of the sick Kummetz)", "flagship": "Scharnhorst", "bio": "A destroyer man — the survivor of Narvik — sent to sea with a battleship in a gale he thought too heavy for his escorts. He detached the destroyers, ran into Burnett's cruisers twice, lost his radar to Norfolk's second hit, and turned for home along the one course that led to Fraser.", "fate": "Lost with Scharnhorst, 26 December 1943.", "wiki": "Erich_Bey" },
  "force2": { "name": "Admiral Sir Bruce Fraser", "role": "Commander-in-Chief, Home Fleet", "flagship": "HMS Duke of York", "bio": "Had rehearsed exactly this: a radar approach in darkness, starshell at 12,000 yards, then the destroyers. Warned by Ultra and by his own reading of the convoy cycle, he placed Force 2 to the south-west of the convoy where Scharnhorst would have to pass on her way home.", "fate": "First Sea Lord 1948–51; Baron Fraser of North Cape.", "wiki": "Bruce_Fraser,_1st_Baron_Fraser_of_North_Cape" },
  "force1": { "name": "Vice-Admiral Robert Burnett", "role": "Commander, 10th Cruiser Squadron (Force 1)", "flagship": "HMS Belfast", "bio": "Fought Scharnhorst twice with three cruisers, drove her off the convoy both times, and — criticised at the time — fell back on the convoy rather than chase a faster ship in the dark. His shadowing report at 12:41 gave Fraser the interception.", "fate": "Commander-in-Chief Plymouth; died 1959.", "wiki": "Robert_Burnett" },
  "convoy": { "name": "Rear-Admiral Maitland Boucher (retd), Commodore", "role": "Convoy Commodore, JW 55B", "flagship": "Fort Kullyspell", "bio": "Nineteen merchant ships at eight knots, the bait in Fraser's trap; turned away from the enemy twice and delivered every ship to Kola.", "fate": "Survived the war." },
  "zflot": { "name": "Kapitän zur See Rolf Johannesson", "role": "Commander, 4th Destroyer Flotilla", "flagship": "Z29", "bio": "Ordered into a search line at 07:55, his five destroyers passed eight miles south of the convoy without seeing it and were sent home at 14:18 — leaving Scharnhorst alone.", "fate": "Survived the war; later a Bundesmarine admiral." }
 },
