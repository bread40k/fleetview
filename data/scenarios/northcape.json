 "routes": {
  "scharnhorst": [["25 19:00", 70.05, 22.7, "Sails from Langfjord with Z29, Z34 and Z38 on Dönitz's order 'Ostfront 1700/25/12'", "S"], ["25 20:30", 70.25, 22.6, "Stjernsund; Z30 and Z33 join", "R"], ["25 22:00", 70.55, 22.2], ["25 23:00", 70.9, 22.4, "Clears the fjords; Z30 and Z33 join; north at 25 knots into a rising south-westerly gale", "R"], ["26 07:03", 73.9, 20.5, "South of Bear Island, turns to attack the convoy at 10:00", "R"], ["26 08:40", 73.7, 22.85, "Belfast's radar finds her at 35,000 yards — unaware, her own radar switched off", "R"], ["26 09:30", 73.6, 23.3, "Norfolk's 8-inch hit wrecks the forward radar; Scharnhorst turns away at 30 knots", "R"], ["26 10:20", 73.85, 24.3, "Runs north-east round the cruisers to try again from the other side; contact lost", "R"], ["26 12:21", 74.25, 23.35, "Second action: Belfast, Sheffield and Norfolk engage at 11,000 yards", "R"], ["26 12:41", 74.1, 23.55, "Bey gives up the convoy — course 155°, 28 knots, for home. Straight toward Fraser", "R"], ["26 16:17", 72.35, 26.55, "Duke of York's radar: contact at 45,500 yards, bearing 020°", "R"], ["26 16:50", 72.3, 26.7, "Illuminated by Belfast's starshell; Duke of York opens fire at 12,000 yards — turrets found trained fore and aft", "R"], ["26 18:20", 72.25, 28, "A 14-inch shell in No. 1 boiler room: speed falls to 22 knots; the destroyers close", "R"], ["26 19:45", 72.267, 28.683, "Sinks after some 11 torpedo hits — 72°16′N 28°41′E; 36 of 1,968 survive", "S"]],
  "zflot": [["25 19:00", 70.05, 22.7, null, "S"], ["25 20:30", 70.25, 22.6], ["25 22:00", 70.55, 22.2], ["25 23:00", 70.9, 22.4], ["26 07:03", 73.9, 20.5], ["26 07:55", 73.75, 21.5, "Ordered into a search line five miles apart on 230° — and never see Scharnhorst again", "R"], ["26 10:27", 73.2, 21.2, "Turned onto 070° at 25 knots", "R"], ["26 13:00", 73.95, 22, "Pass eight miles south of the convoy without sighting it", "R"], ["26 14:18", 73.6, 23, "Ordered home to Altafjord", "R"], ["27 03:00", 70.55, 22.2], ["27 05:00", 70.25, 22.6], ["27 12:00", 70.05, 22.7], ["28 00:00", 70.05, 22.7]],
  "force1": [["22 00:00", 69.3, 33.5, "Kola Inlet after escorting JW 55A", "R"], ["23 12:00", 69.6, 33, "Sails to cover JW 55B", "R"], ["26 04:00", 73.867, 27.2, "73°52′N 27°12′E, course 235°, 18 knots — closing the convoy from the east", "S"], ["26 08:40", 73.583, 23.35, "Belfast radar contact bearing 295°, 35,000 yards", "S"], ["26 09:24", 73.55, 23.1, "Starshell; Norfolk opens fire at 9,800 yards", "R"], ["26 09:55", 73.6, 22.6, "Burnett falls back on the convoy rather than chase a faster ship in the dark", "R"], ["26 10:45", 73.817, 21.967, "73°49′N 21°58′E; the convoy 28,000 yards ahead", "S"], ["26 12:00", 74.183, 22.3, "Noon position: 74°11′N 22°18′E, the convoy nine miles on the port quarter", "S"], ["26 12:21", 74.2, 22.7, "Scharnhorst regained bearing 075°; fire opened at 11,000 yards — Norfolk hit twice, seven killed", "R"], ["26 12:41", 74.05, 23.2, "Shadows at 7½ miles as Scharnhorst runs south", "R"], ["26 14:30", 73.3, 24.8, "Norfolk fights a fire; Sheffield's shaft fails — Belfast shadows alone", "R"], ["26 16:50", 72.45, 26.4, "Fires starshell over Scharnhorst for Duke of York", "R"], ["26 19:45", 72.3, 28.6, "Belfast and Jamaica torpedo the wreck; 'only wreckage'", "R"], ["28 00:00", 69.3, 33.5]],
